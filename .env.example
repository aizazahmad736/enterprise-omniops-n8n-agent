# OmniOps Environment Configuration

# OpenAI API Key (Used by n8n LangChain Chat Model)
OPENAI_API_KEY=your_openai_api_key_here

# Alternatively, Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Mock Enterprise API Port
MOCK_API_PORT=8000

# n8n Host & Port Configuration
N8N_PORT=5678
N8N_WEBHOOK_URL=http://localhost:5678/
